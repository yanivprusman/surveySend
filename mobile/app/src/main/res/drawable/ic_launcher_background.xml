<?xml version="1.0" encoding="utf-8"?>
<!--
  Deep indigo ground with a soft light from the upper-right — the direction the
  foreground bubble's own highlight implies, so the mark reads as one object lit
  once rather than two shapes stacked.

  Flat-ish on purpose: an adaptive icon gets masked to a circle, a squircle or a
  rounded square depending on the launcher, and detail near the edge is the part
  that disappears. Everything that matters lives in the centre 66 of 108.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="70" android:centerY="34" android:gradientRadius="88"
                android:startColor="#3A4F7D"
                android:endColor="#1E2A44" />
        </aapt:attr>
    </path>
</vector>
